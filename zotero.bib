@article{braffPhi2Plastic2026,
	title = {Phi, √2 and the Plastic Ratio: Irrational Proportions in Fractal Swing},
	rights = {Creative Commons Attribution 4.0 International},
	url = {https://zenodo.org/doi/10.5281/zenodo.19703839},
	doi = {10.5281/ZENODO.19703839},
	shorttitle = {Phi, √2 and the Plastic Ratio},
	abstract = {This project investigates the performability of fractal swing — self-similar rhythmic structures generated by iterated swinging substitution rules — in the specific context of bowed string playing. Building on the Generalized Theory of Swing ({GToS}), a framework developed over twenty years of practice, and on its recent extension into fractal swing (Braff, 2026, Puigcerdà), the research explores how these structures can be embodied and realized at the bow. Methods combine my own perceptual and theoretical exploration, taxonomic analysis of bowing techniques in collaboration with violinist Paula Pérez, the development of études for violin, and the composition of a string quartet as empirical site of verification. The long-term horizon of this work is the establishment of a performance practice of fractal swing, opening the {GToS} framework to the world of classical music.},
	publisher = {Zenodo},
	author = {Braff, Malcolm},
	urldate = {2026-06-08},
